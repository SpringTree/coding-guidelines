{
  "name": "@springtree/coding",
  "version": "1.1.3",
  "description": "The SpringTree coding guidelines and project setup helper",
  "keywords": [
    "bootstrap",
    "coding",
    "guidelines",
    "oxc",
    "springtree"
  ],
  "homepage": "https://github.com/SpringTree/coding-guidelines#readme",
  "bugs": {
    "url": "https://github.com/SpringTree/coding-guidelines/issues"
  },
  "license": "ISC",
  "author": "Mark Doeswijk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpringTree/coding-guidelines.git"
  },
  "bin": {
    "springtree-coding": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/prompts": "^2.4.9",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
